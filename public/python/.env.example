# ============================================================================
# Video Note Architect - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# ============================================================================

# ============================================================================
# AI Provider API Keys (at least one required)
# ============================================================================

# Google Gemini (Recommended - Free tier available)
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional - for GPT-4 support)
# Get your key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude (Optional - for Claude 3 support)
# Get your key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Cohere (Optional - for Command R+ support)
# Get your key: https://dashboard.cohere.com/
COHERE_API_KEY=

# Mistral AI (Optional - for Mistral Large support)
# Get your key: https://console.mistral.ai/
MISTRAL_API_KEY=

# ============================================================================
# Model Configuration
# ============================================================================

# Whisper Model Size (for local transcription)
# Options: tiny, base, small, medium, large-v2, large-v3
# Default: base (good balance of speed and accuracy)
WHISPER_MODEL_SIZE=base

# AI Model Selection (override defaults)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4
ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================================================
# Application Settings
# ============================================================================

# Output Directory (where notes are saved)
# Default: ./notes
OUTPUT_DIR=./notes

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Generation Temperature (0.0 = deterministic, 2.0 = creative)
# Default: 0.3 (factual accuracy)
TEMPERATURE=0.3

# Maximum Output Tokens
# Default: 4096
MAX_TOKENS=4096

# ============================================================================
# Feature Flags
# ============================================================================

# Enable Streaming Output (real-time terminal rendering)
# Options: true, false
# Default: true
ENABLE_STREAMING=true

# Enable Caching (avoid re-processing same video)
# Options: true, false
# Default: false
ENABLE_CACHING=false

# Cleanup Temporary Files (delete audio files after processing)
# Options: true, false
# Default: true
CLEANUP_TEMP_FILES=true

# ============================================================================
# Advanced Settings (Optional)
# ============================================================================

# Custom System Prompt File (override default note structure)
# CUSTOM_PROMPT_FILE=./prompts/custom_prompt.txt

# Proxy Settings (if behind corporate firewall)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Timeout Settings (in seconds)
# API_TIMEOUT=60
# DOWNLOAD_TIMEOUT=300
